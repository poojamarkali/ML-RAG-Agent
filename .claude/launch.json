{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "run_server.py", "api"],
      "port": 8000
    },
    {
      "name": "ui",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "streamlit", "run", "ui/app.py", "--server.port=8501", "--server.headless=true"],
      "port": 8501
    }
  ]
}
