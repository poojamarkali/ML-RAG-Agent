# ---- LLM: "groq" or "bedrock" ----
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ---- AWS Bedrock (set LLM_PROVIDER=bedrock) ----
# Easiest: a Bedrock API key (Bedrock console -> API keys). Leave the AWS_ACCESS_* lines empty.
AWS_BEARER_TOKEN_BEDROCK=
# Or classic IAM access keys (or an AWS CLI profile instead of both):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Must be an inference-profile ID. List yours: aws bedrock list-inference-profiles --region us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-opus-5-5

# ---- Qdrant: leave empty to use a local folder (data/qdrant_storage) ----
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ml_documents

# ---- SQL: default is SQLite in data/database. Postgres example: ----
# DATABASE_URL=postgresql+psycopg://ml:ml@localhost:5432/ml_metrics

# ---- Models ----
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Semantic cache ----
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# ---- LangSmith tracing (optional) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ML_RAG_AI_AGENT

# ---- Admin endpoints (/admin/...): if set, send it as the X-Admin-Key header ----
ADMIN_API_KEY=
