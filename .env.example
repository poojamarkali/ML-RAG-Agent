# ---- LLM: "groq" or "bedrock" ----
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Bedrock uses your normal AWS credentials (these vars, or an AWS profile)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# ---- Qdrant: leave empty to use a local folder (data/qdrant_storage) ----
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ml_documents

# ---- SQL: default is SQLite in data/database. Postgres example: ----
# DATABASE_URL=postgresql+psycopg://ml:ml@localhost:5432/ml_metrics

# ---- Models ----
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Semantic cache ----
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# ---- LangSmith tracing (optional) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ML_RAG_AI_AGENT
